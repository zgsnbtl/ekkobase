# NocoBase 生产环境环境变量配置
# 复制此文件为 .env 或直接在此修改

# === 应用配置 ===
APP_KEY=your-very-secure-key-change-this-in-production
APP_PORT=13000
NODE_ENV=production

# === 数据库配置 ===
DB_DIALECT=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nocobase
DB_USER=nocobase
DB_PASSWORD=nocobase

# === MySQL Root 密码 ===
MYSQL_ROOT_PASSWORD=nocobase

# === 其他配置 ===
DB_UNDERSCORED=true
TZ=Asia/Shanghai

# === 可选配置 ===
# 如需使用外部数据库，修改以下配置
# DB_HOST=your-db-host
# DB_PORT=3306
# DB_USER=your-db-user
# DB_PASSWORD=your-db-password